# Скопируйте этот файл в .env.local (для локального запуска)
# и .env.docker (для запуска через docker compose) и впишите свои значения

SECRET_KEY=change-me-to-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Параметры подключения к PostgreSQL (для Django)
DB_NAME=askpupkin
DB_USER=askpupkin
DB_PASSWORD=change-me
# Для локального запуска: localhost, для Docker Compose: db
DB_HOST=localhost
DB_PORT=5432

# Параметры контейнера PostgreSQL (используются в docker-compose)
POSTGRES_DB=askpupkin
POSTGRES_USER=askpupkin
POSTGRES_PASSWORD=change-me
